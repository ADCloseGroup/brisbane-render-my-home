# ─────────────────────────────────────────────────────────────
#  Render My Home — environment variables
#  Copy to `.env.local` for local dev. Set the same keys in the
#  Vercel UI (Project → Settings → Environment variables) for prod.
#  The app RUNS WITHOUT KEYS using mock generation, so you can
#  demo the full flow before any billing is set up.
# ─────────────────────────────────────────────────────────────

# ---- Google (Maps / Places / Street View) ----
# Client-side key: restrict by HTTP referrer in Google Cloud Console.
# Enable: Maps JavaScript API, Places API, Street View Static API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-side key for Street View Static fetches (restrict by IP / none, server-only).
# Can be the same project; keep it OUT of NEXT_PUBLIC_* so it never ships to the browser.
GOOGLE_STREETVIEW_API_KEY=

# ---- Render engine: Gemini 2.5 Flash Image (nano banana) ----
# Get from Google AI Studio (https://aistudio.google.com/apikey) or Vertex.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY. Never expose. Used by /api/lead to insert.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Email (Resend) ----
RESEND_API_KEY=
LEAD_FROM_EMAIL="Brisbane Rendering <hello@brisbanerendering.com.au>"
LEAD_INTERNAL_EMAIL=leads@brisbanerendering.com.au

# ---- CRM webhook (generic; point at Zapier/Make/HubSpot/GHL/Simpro relay) ----
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# ---- Analytics ----
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ---- Abuse prevention ----
# Cloudflare Turnstile (invisible captcha on lead submit)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Feature flags ----
# Set to "false" to instantly disable rendering of Google Street View imagery
# (leaves the address-finder working; forces upload for the actual render).
STREETVIEW_RENDER_ENABLED=true

# ─────────────────────────────────────────────────────────────
#  Read by the code but previously undocumented. All optional —
#  each has a default or degrades to a no-op when unset.
# ─────────────────────────────────────────────────────────────

# ---- Simpro (lead creation on submit, src/lib/simpro.ts) ----
# createSimproLead() runs on every /api/lead POST and no-ops without these.
# NOTE: a Simpro API token is not scoped to one company by Simpro itself, so a
# key here can reach more than the company id below. Issue a dedicated one.
SIMPRO_BASE_URL=
SIMPRO_API_KEY=
SIMPRO_COMPANY_ID=

# ---- Render engine tuning ----
# Model for the classify step (storeys / complexity), not the image render.
GEMINI_CLASSIFY_MODEL=gemini-2.5-flash
# Try progressively cheaper image paths before the full render.
IMAGE_CASCADE_ENABLED=
# Reject Street View panoramas further than this from the requested address.
PANO_MAX_DISTANCE_M=
